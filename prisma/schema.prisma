generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  OWNER_PRINCIPAL
  SUPPORT_ADMIN
  AGENT_SERVICE
  READ_ONLY_REVIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthProviderKind {
  LOCAL_DEV_PLACEHOLDER
  FUTURE_PROVIDER
}

enum AuditEventType {
  LOGIN
  FAILED_LOGIN
  PERMISSION_CHANGE
  CLIENT_CREATED
  CLIENT_EDITED
  CLIENT_RECORD_ACCESSED
  MATTER_CREATED
  MATTER_EDITED
  MATTER_RECORD_ACCESSED
  MATTER_NOTE_ADDED
  DOCUMENT_ACCESSED
  DRAFT_CREATED
  BILLING_LINE_ITEM_CREATED
  BILLING_LINE_ITEM_EDITED
  INVOICE_CREATED
  INVOICE_SUBMITTED_FOR_APPROVAL
  INVOICE_APPROVED
  INVOICE_NUMBER_ASSIGNED
  INVOICE_SENT
  INVOICE_CANCELLED
  INVOICE_CORRECTED
  STATEMENT_SNAPSHOT_CREATED
  STATEMENT_SUBMITTED_FOR_APPROVAL
  STATEMENT_APPROVED
  STATEMENT_SENT
  STATEMENT_CORRECTED
  PAYMENT_IMPORT_CHANGED
  FINANCIAL_CORRECTION_CREATED
  VAT_TREATMENT_OVERRIDDEN
  AGENT_ACTION
  DOCUMENT_METADATA_CREATED
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  TIMELINE_EVENT_CREATED
  MARKETING_APPROVED
  OUTREACH_APPROVED
}

enum AgentActionStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED_BY_OWNER
  REJECTED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContactType {
  PRIMARY
  BILLING
  LEGAL_CONTACT
  OTHER
}

enum MatterType {
  FAMILY_LAW
  MAINTENANCE
  DIVORCE
  CARE_AND_CUSTODY
  COMMERCIAL_LAW
  FINANCIAL_DISTRESS
  CONTRACTS
  BUSINESS_RESCUE
  CIVIL_LITIGATION
  OTHER
}

enum MatterStatus {
  OPEN
  PENDING
  WAITING_ON_CLIENT
  WAITING_ON_COURT
  WAITING_ON_PAYMENT
  CLOSED
  ARCHIVED
}

enum MatterAssignmentRole {
  RESPONSIBLE_ATTORNEY
  SUPPORT_USER
  VIEWER
}

enum DocumentVisibility {
  PRIVATE
  INTERNAL
}

enum DocumentStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum TimelineEventType {
  CLIENT_CREATED
  CLIENT_EDITED
  MATTER_CREATED
  MATTER_EDITED
  MATTER_NOTE_ADDED
  DOCUMENT_METADATA_CREATED
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  DOCUMENT_ACCESSED
  AUDIT_EVENT_RECORDED
}

enum BillingLineItemStatus {
  DRAFT
  AWAITING_REVIEW
  APPROVED_FOR_INVOICE
  REJECTED
  INVOICED
  CORRECTED
}

enum BillingItemTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum BillingCategory {
  TIME
  FOLIO
  PAGE
  FIXED_TARIFF
  DISBURSEMENT
  ADJUSTMENT
  CORRECTION
}

enum VatTreatment {
  VAT_ON_FEES
  NO_VAT
  VAT_EXEMPT
  CUSTOM
}

enum InvoiceStatus {
  DRAFT
  AWAITING_OWNER_APPROVAL
  APPROVED
  SENT
  CANCELLED
  CORRECTED
  PAID
  PART_PAID
  OVERDUE
}

enum StatementStatus {
  DRAFT
  AWAITING_OWNER_APPROVAL
  APPROVED
  SENT
  UPDATED_AFTER_PAYMENT
  CLOSED
  CORRECTED
}

enum FinancialCorrectionType {
  LINE_ITEM_CORRECTION
  INVOICE_CORRECTION
  STATEMENT_CORRECTION
  VAT_CORRECTION
  ADMIN_CORRECTION
}

enum FinancialRecordSource {
  MANUAL
  AGENT_DRAFT
  SYSTEM
  CORRECTION
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  status          UserStatus       @default(ACTIVE)
  authProvider    AuthProviderKind @default(LOCAL_DEV_PLACEHOLDER)
  externalSubject String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roles        UserRole[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  agentActions AgentAction[] @relation("AgentActor")
  responsibleMatters Matter[] @relation("ResponsibleAttorney")
  supportMatters     Matter[] @relation("SupportUser")
  matterAssignments  MatterAssignment[]
  matterNotes        MatterNote[]
  uploadedDocuments  DocumentRecord[] @relation("DocumentUploader")
  timelineEvents     TimelineEvent[]  @relation("TimelineActor")
  billingLineItems   BillingLineItem[] @relation("BillingLineItemCreator")
  invoicesCreated    Invoice[]        @relation("InvoiceCreator")
  invoicesApproved   Invoice[]        @relation("InvoiceApprover")
  invoiceNumbersAssigned Invoice[]     @relation("InvoiceNumberAssigner")
  invoiceApprovals   InvoiceApproval[]
  statementsCreated  StatementSnapshot[] @relation("StatementCreator")
  statementsApproved StatementSnapshot[] @relation("StatementApprover")
  statementApprovals StatementApproval[]
  financialCorrections FinancialCorrectionRecord[] @relation("FinancialCorrectionActor")
}

model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id         String         @id @default(cuid())
  eventType  AuditEventType
  actorId    String?
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  sensitive  Boolean        @default(true)
  createdAt  DateTime       @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([actorId])
  @@index([targetType, targetId])
}

model AgentAction {
  id              String            @id @default(cuid())
  agentUserId     String?
  actionType      String
  sourceChannel   String?
  sourceReference String?
  draftTargetType String?
  draftTargetId   String?
  confidenceScore Float?
  status          AgentActionStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  agentUser User? @relation("AgentActor", fields: [agentUserId], references: [id], onDelete: SetNull)

  @@index([agentUserId])
  @@index([status])
}

model Client {
  id               String       @id @default(cuid())
  accountNumber    String       @unique
  displayName      String
  normalizedSearch String
  status           ClientStatus @default(ACTIVE)
  primaryContactId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  primaryContact Contact?        @relation("ClientPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  contacts       Contact[]       @relation("ClientContacts")
  matters        Matter[]
  documents      DocumentRecord[]
  timelineEvents TimelineEvent[]
  invoices       Invoice[]
  statements     StatementSnapshot[]

  @@index([status])
  @@index([normalizedSearch])
}

model Contact {
  id             String      @id @default(cuid())
  clientId       String
  name           String
  email          String?
  phone          String?
  whatsappNumber String?
  type           ContactType @default(OTHER)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  client            Client   @relation("ClientContacts", fields: [clientId], references: [id], onDelete: Restrict)
  primaryForClients Client[] @relation("ClientPrimaryContact")

  @@index([clientId])
  @@index([type])
}

model Matter {
  id                    String       @id @default(cuid())
  clientId              String
  accountNumber         String
  normalizedSearch      String
  name                  String
  description           String
  type                  MatterType
  status                MatterStatus @default(OPEN)
  responsibleAttorneyId String?
  supportUserId         String?
  nextStepDueDate       DateTime?
  openedAt              DateTime     @default(now())
  closedAt              DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  client              Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  responsibleAttorney User?              @relation("ResponsibleAttorney", fields: [responsibleAttorneyId], references: [id], onDelete: SetNull)
  supportUser         User?              @relation("SupportUser", fields: [supportUserId], references: [id], onDelete: SetNull)
  assignments         MatterAssignment[]
  notes               MatterNote[]
  documents           DocumentRecord[]
  timelineEvents      TimelineEvent[]
  billingLineItems    BillingLineItem[]
  invoices            Invoice[]
  statements          StatementSnapshot[]

  @@index([clientId])
  @@index([accountNumber])
  @@index([type])
  @@index([status])
  @@index([nextStepDueDate])
  @@index([normalizedSearch])
}

model MatterAssignment {
  id        String               @id @default(cuid())
  matterId  String
  userId    String
  role      MatterAssignmentRole
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([matterId, userId, role])
  @@index([userId])
}

model MatterNote {
  id        String   @id @default(cuid())
  matterId  String
  authorId  String?
  body      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Restrict)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([matterId])
  @@index([authorId])
}

model DocumentRecord {
  id          String             @id @default(cuid())
  clientId    String?
  matterId    String?
  storageKey  String
  filename    String
  contentType String
  sizeBytes   Int?
  visibility  DocumentVisibility @default(PRIVATE)
  status      DocumentStatus     @default(ACTIVE)
  uploadedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  client     Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matter     Matter? @relation(fields: [matterId], references: [id], onDelete: Restrict)
  uploadedBy User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  content    DocumentContent?

  @@index([clientId])
  @@index([matterId])
  @@index([visibility])
  @@index([status])
}

model DocumentContent {
  id         String   @id @default(cuid())
  documentId String   @unique
  bytes      Bytes
  sha256     String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  document DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([sha256])
}

model TimelineEvent {
  id          String            @id @default(cuid())
  eventType   TimelineEventType
  actorId     String?
  subjectType String
  subjectId   String
  clientId    String?
  matterId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime          @default(now())

  actor  User?   @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  matter Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([actorId])
  @@index([subjectType, subjectId])
  @@index([clientId])
  @@index([matterId])
}

model BillingLineItem {
  id                String                @id @default(cuid())
  matterId          String
  description       String
  category          BillingCategory
  status            BillingLineItemStatus @default(DRAFT)
  quantity          Int                   @default(1)
  unitAmountCents   Int
  totalAmountCents  Int
  currency          String                @default("ZAR")
  vatTreatment      VatTreatment
  vatAmountCents    Int                   @default(0)
  source            FinancialRecordSource @default(MANUAL)
  sourceReference   String?
  createdById       String?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  matter    Matter @relation(fields: [matterId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("BillingLineItemCreator", fields: [createdById], references: [id], onDelete: SetNull)

  invoiceLines InvoiceLine[]

  @@index([matterId])
  @@index([status])
  @@index([category])
}

model BillingItemTemplate {
  id              String                    @id @default(cuid())
  label           String
  normalizedSearch String
  category        BillingCategory
  description     String
  amountCents     Int
  currency        String                    @default("ZAR")
  vatTreatment    VatTreatment
  status          BillingItemTemplateStatus @default(ACTIVE)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([normalizedSearch])
  @@index([category])
  @@index([status])
}

model Invoice {
  id                         String                @id @default(cuid())
  clientId                   String
  matterId                   String
  internalDraftReference      String                @unique
  officialInvoiceNumber       String?               @unique
  status                     InvoiceStatus         @default(DRAFT)
  subtotalCents              Int
  vatAmountCents             Int                   @default(0)
  totalCents                 Int
  currency                   String                @default("ZAR")
  source                     FinancialRecordSource @default(MANUAL)
  createdById                String?
  approvedById               String?
  approvedAt                 DateTime?
  invoiceNumberAssignedById  String?
  invoiceNumberAssignedAt    DateTime?
  invoiceNumberSequenceId    String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  client                  Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matter                  Matter                 @relation(fields: [matterId], references: [id], onDelete: Restrict)
  createdBy               User?                  @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy              User?                  @relation("InvoiceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  invoiceNumberAssignedBy User?                  @relation("InvoiceNumberAssigner", fields: [invoiceNumberAssignedById], references: [id], onDelete: SetNull)
  invoiceNumberSequence   InvoiceNumberSequence? @relation(fields: [invoiceNumberSequenceId], references: [id], onDelete: SetNull)
  lines                   InvoiceLine[]
  approvals               InvoiceApproval[]
  statements              StatementLine[]

  @@index([clientId])
  @@index([matterId])
  @@index([status])
  @@index([approvedAt])
}

model InvoiceLine {
  id                String  @id @default(cuid())
  invoiceId         String
  billingLineItemId String?
  description       String
  category          BillingCategory
  quantity          Int     @default(1)
  unitAmountCents   Int
  totalAmountCents  Int
  vatTreatment      VatTreatment
  vatAmountCents    Int     @default(0)
  currency          String  @default("ZAR")
  position          Int
  createdAt         DateTime @default(now())

  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  billingLineItem BillingLineItem? @relation(fields: [billingLineItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([billingLineItemId])
}

model InvoiceApproval {
  id         String   @id @default(cuid())
  invoiceId  String
  approverId String
  approvedAt DateTime @default(now())
  notes      String?

  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  approver User    @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([approverId])
}

model InvoiceNumberSequence {
  id          String   @id @default(cuid())
  scope       String   @unique
  prefix      String
  nextNumber  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices Invoice[]
}

model StatementSnapshot {
  id              String          @id @default(cuid())
  clientId        String
  matterId        String?
  status          StatementStatus @default(DRAFT)
  statementPeriodStart DateTime?
  statementPeriodEnd   DateTime?
  openingBalanceCents  Int       @default(0)
  closingBalanceCents  Int
  currency        String          @default("ZAR")
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client     Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matter     Matter?             @relation(fields: [matterId], references: [id], onDelete: SetNull)
  createdBy  User?               @relation("StatementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?               @relation("StatementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines      StatementLine[]
  approvals  StatementApproval[]

  @@index([clientId])
  @@index([matterId])
  @@index([status])
}

model StatementLine {
  id                  String   @id @default(cuid())
  statementSnapshotId  String
  invoiceId           String?
  description         String
  lineDate            DateTime?
  debitCents          Int      @default(0)
  creditCents         Int      @default(0)
  balanceCents        Int
  currency            String   @default("ZAR")
  position            Int
  createdAt           DateTime @default(now())

  statementSnapshot StatementSnapshot @relation(fields: [statementSnapshotId], references: [id], onDelete: Restrict)
  invoice           Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([statementSnapshotId])
  @@index([invoiceId])
}

model StatementApproval {
  id                  String   @id @default(cuid())
  statementSnapshotId  String
  approverId          String
  approvedAt          DateTime @default(now())
  notes               String?

  statementSnapshot StatementSnapshot @relation(fields: [statementSnapshotId], references: [id], onDelete: Restrict)
  approver          User              @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@index([statementSnapshotId])
  @@index([approverId])
}

model FinancialCorrectionRecord {
  id               String                  @id @default(cuid())
  correctionType   FinancialCorrectionType
  targetRecordType String
  targetRecordId   String
  actorId          String
  reason           String
  amountDeltaCents Int?
  currency         String                  @default("ZAR")
  createdAt        DateTime                @default(now())

  actor User @relation("FinancialCorrectionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetRecordType, targetRecordId])
  @@index([actorId])
  @@index([correctionType])
}
